{
  "name": "@cattyshack/shared",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Shared code for Cattyshack Automation Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/*": {
      "types": "./dist/db/*.d.ts",
      "default": "./dist/db/*.js"
    },
    "./db/queries/*": {
      "types": "./dist/db/queries/*.d.ts",
      "default": "./dist/db/queries/*.js"
    },
    "./services/hue": {
      "types": "./dist/services/hue/index.d.ts",
      "default": "./dist/services/hue/index.js"
    },
    "./services/streaming": {
      "types": "./dist/services/streaming/index.d.ts",
      "default": "./dist/services/streaming/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "default": "./dist/schemas/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "db:setup": "npm run db:generate && npm run db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "drizzle-kit push --force"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.44.5",
    "node-hue-api": "^5.0.0-beta.16",
    "winston": "^3.17.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.2.2"
  }
}
