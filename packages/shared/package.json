{
  "name": "@cattyshack/shared",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Shared code for Cattyshack Automation Platform",
  "main": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./db": "./lib/db/index.ts",
    "./db/*": "./lib/db/*.ts",
    "./db/queries/*": "./lib/db/queries/*.ts",
    "./services/hue": "./lib/services/hue/index.ts",
    "./services/streaming": "./lib/services/streaming/index.ts",
    "./types/*": "./lib/types/*.ts",
    "./schemas": "./lib/schemas/index.ts",
    "./schemas/*": "./lib/schemas/*.ts",
    "./utils/*": "./lib/utils/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:setup": "npm run db:generate && npm run db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "drizzle-kit push --force"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.44.5",
    "node-hue-api": "^5.0.0-beta.16",
    "winston": "^3.17.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.2.2"
  }
}
